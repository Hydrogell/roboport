# Любая ОС видит одни и те же line endings — иначе rsync с Windows-dev'а
# тащит CRLF на Linux-хост, и bash-скрипты падают на $'\r'.

* text=auto

# Скрипты и конфиги, которые исполняются/парсятся на Linux — всегда LF.
*.sh           text eol=lf
*.py           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.conf         text eol=lf
*.service      text eol=lf
*.nginx.conf   text eol=lf
.githooks/*    text eol=lf
deploy/*       text eol=lf

# Бинарники — без преобразований.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
