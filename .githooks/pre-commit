#!/usr/bin/env bash
# Pre-commit hook: catch syntax errors и подозрительные debug-print'ы до того
# как они уедут в master. Активируется через git config core.hooksPath .githooks
# (см. README.md → «Pre-commit hook»).

set -u

py_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -z "$py_files" ]; then
    exit 0
fi

# --- 1. py_compile — catch syntax/imports на этапе компиляции ---------------
fail=0
echo "[pre-commit] py_compile $(echo "$py_files" | wc -l) файлов"
while IFS= read -r f; do
    [ -f "$f" ] || continue
    if ! python -m py_compile "$f" 2>&1; then
        echo "[pre-commit] ❌ syntax/import error в $f"
        fail=1
    fi
done <<< "$py_files"

# --- 2. подозрительные print'ы с секретами ----------------------------------
# Совпадение != автомат. бан, но требует --no-verify если автор уверен.
# Ловим: print(... password|api_key|plain|secret|token ...).
secret_re='print\([^)]*(password|api_key|plain[^_]|secret|token)[^)]*\)'
hits=$(echo "$py_files" | tr '\n' '\0' | xargs -0 -r grep -nEi "$secret_re" 2>/dev/null || true)
if [ -n "$hits" ]; then
    echo ""
    echo "[pre-commit] ⚠ найдены print() с похоже-секретными аргументами:"
    echo "$hits" | sed 's/^/    /'
    echo ""
    echo "    → если это debug — оберни в auth.mask_api_key() или удали"
    echo "    → если ложное срабатывание — git commit --no-verify"
    fail=1
fi

# --- 3. блок merge-conflict markers -----------------------------------------
conflict_hits=$(echo "$py_files" | tr '\n' '\0' | xargs -0 -r grep -nE '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null || true)
if [ -n "$conflict_hits" ]; then
    echo ""
    echo "[pre-commit] ❌ остались merge-conflict markers:"
    echo "$conflict_hits" | sed 's/^/    /'
    fail=1
fi

if [ "$fail" -eq 1 ]; then
    echo ""
    echo "[pre-commit] commit заблокирован — fix issues или --no-verify"
    exit 1
fi
echo "[pre-commit] ✅ ok"
exit 0
