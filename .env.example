# The installer copies this file to .env. You can also change these values
# in Panel settings → General.

# Factorio.com account used for mod downloads and public server listing.
# Get your token from https://www.factorio.com/profile.
FACTORIO_USERNAME=
FACTORIO_TOKEN=

# Time zone for history and schedules. Examples: Europe/Moscow, UTC, +5:30.
# An empty value uses the host time zone.
PANEL_TZ=
